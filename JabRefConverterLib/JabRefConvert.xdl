<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="JabRefConvert" dlg:left="173" dlg:top="84" dlg:width="240" dlg:height="90" dlg:title="JabRef converter" dlg:closeable="true" dlg:moveable="true">
 <dlg:bulletinboard>
  <dlg:text dlg:id="ImportLabel" dlg:left="10" dlg:top="10" dlg:width="220" dlg:height="12" dlg:value="Restore JabRef references from portable citation text"/>
  <dlg:button dlg:id="ImportButton" dlg:tab-index="0" dlg:left="55" dlg:top="25" dlg:width="130" dlg:height="18" dlg:value="Text to references">
   <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.script:JabRefConverterLib.Module1.FromTextToReference?language=Basic&amp;location=application" script:language="Script"/>
  </dlg:button>
  <dlg:button dlg:id="ExportButton" dlg:tab-index="1" dlg:left="55" dlg:top="52" dlg:width="130" dlg:height="18" dlg:value="References to text">
   <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.script:JabRefConverterLib.Module1.FromReferenceToText?language=Basic&amp;location=application" script:language="Script"/>
  </dlg:button>
 </dlg:bulletinboard>
</dlg:window>
